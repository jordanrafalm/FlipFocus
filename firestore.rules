rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Reads only the caller's own /users doc (isOwner rule below already permits this).
    function myCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }
    function myCompanyIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyIds', []);
    }
    function belongsToCompany(companyId) {
      return signedIn() && (myCompanyId() == companyId || myCompanyIds().hasAny([companyId]));
    }

    // Built-in companies are bundled locally. Custom company names are public so other users can
    // find and join them; statistics remain restricted in the subcollections below.
    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80;
      allow update, delete: if false;

      // Raw per-user completions stay private to their author; a coworker can never read
      // another employee's row. There is no aggregate/rollup on the free plan.
      match /completions/{completionId} {
        // get(): the client checks its own doc-id ("uid_sessionId") before creating one, while
        // the document may not exist yet, so this only checks the id, never resource.data.
        allow get: if isOwner(request.auth.uid) && belongsToCompany(companyId)
          && completionId.matches(request.auth.uid + '_.+');
        // list(): personalStats() always queries `where uid == callerUid`; Firestore can verify
        // that constraint against this rule ahead of running the query, so a coworker's own
        // list() attempt (whose uid differs from request.auth.uid) is rejected outright.
        allow list: if isOwner(request.auth.uid) && belongsToCompany(companyId)
          && resource.data.uid == request.auth.uid;
        // Owner, matching company, sane minutes, and a completionId that stays "uid_..." so one
        // employee cannot masquerade as another's contribution key; the doc-id-only immutability
        // below (create, never update/delete) is what makes each completion count exactly once.
        allow create: if isOwner(request.resource.data.uid)
          && belongsToCompany(companyId)
          && completionId.matches(request.resource.data.uid + '_.+')
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 180;
        allow update, delete: if false;
      }

      // Public, opt-in ranking row (nickname, optional job title, rolling/all-time totals). Only
      // written by its own owner and only while they are associated with this exact company; never
      // contains other employees' raw completions. Visible to any coworker currently associated with
      // the same company — never to a different company, never server-verified (Spark plan).
      match /ranking/{uid} {
        allow get, list: if belongsToCompany(companyId);
        allow create, update: if isOwner(uid) && belongsToCompany(companyId)
          && request.resource.data.uid == uid;
        allow delete: if isOwner(uid);
      }
    }

    // Private profile: company assignment, job title and quiet hours are owner-only.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Minimal cross-user profile (nickname + nudge/ranking opt-in) for room/nudge features.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
      );
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid);
        // Own membership fields, or another member's nickname kept in sync by its owner.
        allow update: if isOwner(uid) ||
          (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname']));
        allow delete: if isOwner(uid);
      }

      match /weeklyTotals/{totalId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
      }

      match /completions/{completionId} {
        allow read: if signedIn();
        allow create: if isOwner(request.resource.data.uid);
        allow update, delete: if false;
      }
    }

    // collectionGroup("members") is used to find the caller's own room memberships.
    // Keep that query scoped to documents whose uid matches the authenticated user.
    match /{path=**}/members/{memberUid} {
      allow read: if isOwner(resource.data.uid);
    }

    match /nudges/{nudgeId} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || resource.data.senderId == request.auth.uid);
      allow create: if isOwner(request.resource.data.senderId);
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declined']);
      allow delete: if false;
    }

    match /nudgeBlocks/{blockId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.recipientId);
      allow delete: if isOwner(resource.data.recipientId);
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if isOwner(request.resource.data.reporterId);
      allow read, update, delete: if false;
    }
  }
}


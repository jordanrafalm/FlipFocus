// Copy this file to iosApp/Secrets.local.xcconfig (gitignored) and fill in the real value.
// GOOGLE_REVERSED_CLIENT_ID is the REVERSED_CLIENT_ID entry from
// iosApp/iosApp/GoogleService-Info.plist (Firebase console > Project settings > iOS app),
// with "com.googleusercontent.apps." kept as-is — this becomes the app's custom URL scheme so
// Google's sign-in redirect can return control to FlipFocus. It is not a secret by itself (it is
// embedded in the shipped app binary either way), but keeping it out of source control avoids
// hardcoding client-specific values in tracked files.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_WITH_REVERSED_CLIENT_ID
